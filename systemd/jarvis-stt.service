[Unit]
Description=JARVIS - reconnaissance vocale (whisper.cpp, Vulkan)

[Service]
WorkingDirectory=@APP@/vendor/whisper.cpp
Environment=LD_LIBRARY_PATH=@APP@/vendor/whisper.cpp/build/bin
ExecStart=@APP@/vendor/whisper.cpp/build/bin/whisper-server -m ../models/ggml-small.bin --host 127.0.0.1 --port 8178 -l fr -t 8 -bo 1 -bs 1 -nt
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
