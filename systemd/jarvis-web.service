[Unit]
Description=JARVIS - serveur web et pont OpenClaw
After=jarvis-stt.service jarvis-stt-precise.service jarvis-tts.service jarvis-tts-st.service openclaw-gateway.service
Wants=jarvis-stt.service jarvis-stt-precise.service jarvis-tts.service jarvis-tts-st.service

[Service]
WorkingDirectory=@APP@/server
ExecStart=@NODE@ server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
